      </node>
      <node concept="3Tm6S6" id="5NJc6w6FRB3" role="1B3o_S" />
    </node>
    <node concept="Wx3nA" id="5NJc6w6FRB4" role="jymVt">
      <property role="TrG5h" value="APPLY_INTENTION_TOOL_SPEC_SHORT_DESCR" />
      <property role="3TUv4t" value="true" />
      <node concept="3uibUv" id="5NJc6w6FRB5" role="1tU5fm">
        <ref role="3uigEE" to="wyt6:~String" resolve="String" />
      </node>
      <node concept="Xl_RD" id="5NJc6w6FRB6" role="33vP2m">
