    </node>
    <node concept="Wx3nA" id="5NJc6w6FRB8" role="jymVt">
      <property role="TrG5h" value="APPLY_INTENTION_TOOL_SPEC_DESCR" />
      <property role="3TUv4t" value="true" />
      <node concept="3uibUv" id="5NJc6w6FRB9" role="1tU5fm">
        <ref role="3uigEE" to="wyt6:~String" resolve="String" />
      </node>
      <node concept="Xl_RD" id="5NJc6w6FRBa" role="33vP2m">
        <property role="Xl_RC" value="[generic] applies one intention or quick-fix - an entry from f1re-mcp-list-node-intentions, or a quickFixes entry from mps_mcp_check_root_node_problems - on a node, headlessly. Pass nodeReference = the entry's targetNode (for quick-fixes from the check report, the problem node's reference) and intentionId = the entry's id. description disambiguates when several instances share the id; problemMessage pins a quick-fix to a specific problem. The intention path is tried first, then the quick-fix path. On success returns applied, type, description, targetNode and problems.before/after error and warning counts; an unknown id yields NOT_FOUND with a hint to re-list. port note: the apply runs in a write action rather than an undoable command, so it does not form a single undo step in the IDE; the applied intention may also write outside the target model, and only the target model is saved automatically." />
      </node>
      <node concept="3Tm6S6" id="5NJc6w6FRBb" role="1B3o_S" />
    </node>
