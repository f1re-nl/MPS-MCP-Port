        <property role="Xl_RC" value="[generic] list the project's run configurations" />
      </node>
      <node concept="3Tm6S6" id="5NJc6w6Fd_c" role="1B3o_S" />
    </node>
    <node concept="Wx3nA" id="5NJc6w6Fd_d" role="jymVt">
      <property role="TrG5h" value="GET_RUN_CONFIGURATIONS_TOOL_SPEC_DESCR" />
      <property role="3TUv4t" value="true" />
      <node concept="3uibUv" id="5NJc6w6Fd_e" role="1tU5fm">
        <ref role="3uigEE" to="wyt6:~String" resolve="String" />
      </node>
      <node concept="Xl_RD" id="5NJc6w6Fd_f" role="33vP2m">
        <property role="Xl_RC" value="[generic] lists the project's existing run configurations with their names and, when available, launch details (program arguments, working directory, environment variables) and `supportsDynamicLaunchOverrides`. Pass a returned `name` as `configurationName` to `f1re-mcp-execute-run-configuration`. `supportsDynamicLaunchOverrides` is the source-of-truth flag for the one-time launch overrides (`programArguments`, `workingDirectory`, `envs`) of `f1re-mcp-execute-run-configuration`." />
      </node>
      <node concept="3Tm6S6" id="5NJc6w6Fd_g" role="1B3o_S" />
    </node>
    <node concept="Wx3nA" id="5NJc6w6Fd_h" role="jymVt">
      <property role="TrG5h" value="EXECUTE_RUN_CONFIGURATION_TOOL_SPEC_NAME" />
      <property role="3TUv4t" value="true" />
      <node concept="3uibUv" id="5NJc6w6Fd_i" role="1tU5fm">
        <ref role="3uigEE" to="wyt6:~String" resolve="String" />
      </node>
      <node concept="Xl_RD" id="5NJc6w6Fd_j" role="33vP2m">
        <property role="Xl_RC" value="f1re-mcp-execute-run-configuration" />
      </node>
      <node concept="3Tm6S6" id="5NJc6w6Fd_k" role="1B3o_S" />
    </node>
    <node concept="Wx3nA" id="5NJc6w6Fd_l" role="jymVt">
      <property role="TrG5h" value="EXECUTE_RUN_CONFIGURATION_TOOL_SPEC_SHORT_DESCR" />
      <property role="3TUv4t" value="true" />
      <node concept="3uibUv" id="5NJc6w6Fd_m" role="1tU5fm">
        <ref role="3uigEE" to="wyt6:~String" resolve="String" />
      </node>
      <node concept="Xl_RD" id="5NJc6w6Fd_n" role="33vP2m">
        <property role="Xl_RC" value="[generic] run an existing run configuration" />
      </node>
      <node concept="3Tm6S6" id="5NJc6w6Fd_o" role="1B3o_S" />
    </node>
    <node concept="Wx3nA" id="5NJc6w6Fd_p" role="jymVt">
      <property role="TrG5h" value="EXECUTE_RUN_CONFIGURATION_TOOL_SPEC_DESCR" />
      <property role="3TUv4t" value="true" />
      <node concept="3uibUv" id="5NJc6w6Fd_q" role="1tU5fm">
        <ref role="3uigEE" to="wyt6:~String" resolve="String" />
      </node>
      <node concept="Xl_RD" id="5NJc6w6Fd_r" role="33vP2m">
        <property role="Xl_RC" value="[generic] runs an existing run configuration by name (see `f1re-mcp-get-run-configurations`, or create one with `f1re-mcp-create-run-configuration`) and waits up to `timeout` milliseconds for it to finish. With waitForExit=false it returns as soon as the process has started. If the timeout expires, the process keeps running in the background and `exitCode` is omitted. Before-launch tasks (e.g. make) run first and do not count against `timeout`. Optional launch overrides (`programArguments`, `workingDirectory`, `envs`) apply to this run only, are not persisted, and are only accepted by configurations whose `supportsDynamicLaunchOverrides` is true. Returns the output snapshot, the exit code when terminated, and `fullOutputPath` when the output is truncated or the process is still running." />
      </node>
      <node concept="3Tm6S6" id="5NJc6w6Fd_s" role="1B3o_S" />
    </node>
    <node concept="Wx3nA" id="AdckQJ3CJ_" role="jymVt">
      <property role="TrG5h" value="OUTPUT_PREVIEW_LIMIT" />
